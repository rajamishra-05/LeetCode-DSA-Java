class Solution {
    public int reverse(int x) {
        int rev = 0;
        String numStr = Integer.toString(x);
        for (int i = numStr.length(); i > 0; i--) {
            if (x == 0) {
                break;
             }
            int count = x % 10;
            if (rev > Integer.MAX_VALUE / 10 ||
                (rev == Integer.MAX_VALUE / 10 && count > 7) ||
                rev < Integer.MIN_VALUE / 10 ||
                (rev == Integer.MIN_VALUE / 10 && count < -8)) {
                return 0;
            }
            rev = rev * 10 + count;
            x = x / 10;
            
        }
        return rev;

    }
}
